[Unit]
Description=Oxidane Celery Beat Scheduler
After=network.target

[Service]
Type=forking
User=oxidane
Group=oxidane
EnvironmentFile=/var/www/oxidane/.env
WorkingDirectory=/var/www/oxidane/backend
ExecStart=/var/www/oxidane/venv/bin/celery -A oxidane beat --loglevel=info --detach --pidfile=/var/run/celery/beat.pid --logfile=/var/log/celery/beat.log --schedule=/var/www/oxidane/celerybeat-schedule
ExecStop=/bin/kill -s TERM $MAINPID
PIDFile=/var/run/celery/beat.pid
Restart=on-failure
RestartSec=10

# Create directories  
RuntimeDirectory=celery
RuntimeDirectoryMode=755
LogsDirectory=celery
LogsDirectoryMode=755

[Install]
WantedBy=multi-user.target