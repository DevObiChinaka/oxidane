{
  "name": "telegram-testing-suite",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Telegram management system",
  "scripts": {
    "test:all": "npm run test:frontend && npm run test:api && npm run test:backend",
    "test:frontend": "jest --config jest.config.js",
    "test:api": "node test-telegram-api.js",
    "test:backend": "python test_telegram_backend.py",
    "test:browser": "node telegram-api-tests.js",
    "test:watch": "jest --watch --config jest.config.js",
    "test:coverage": "jest --coverage --config jest.config.js",
    "test:ci": "jest --ci --coverage --watchAll=false --config jest.config.js",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --config jest.config.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "axios": "^1.0.0",
    "chalk": "^4.1.2"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}