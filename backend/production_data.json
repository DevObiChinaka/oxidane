: {"password": "pbkdf2_sha256$1000000$6puBUGOPlr4D5t8RkRdW2k$Cnc01Imp4O3XrwdQdh2DImIO0gGkjc3ibt50xJX0Kds=", "last_login": null, "is_superuser": false, "username": "test3", "first_name": "", "last_name": "", "is_staff": false, "is_active": true, "date_joined": "2025-11-09T22:02:28.143Z", "email": "test3@test.com", "avatar": null, "is_email_verified": false, "email_verification_token": null, "email_verification_expires": null, "email_verification_otp": null, "email_verification_otp_expires": null, "password_reset_token": null, "password_reset_expires": null, "password_reset_otp": null, "password_reset_otp_expires": null, "telegram_user_id": null, "current_plan": null, "subscription_status": "none", "subscription_start_date": null, "subscription_end_date": null, "trial_end_date": null, "trial_used": false, "usage_stats": {}, "created_at": "2025-11-09T22:02:29.025Z", "updated_at": "2025-11-09T22:02:29.025Z", "groups": [], "user_permissions": []}}, {"model": "users.emailtemplate", "pk": "052616c7-268e-4036-9cf0-7c5e5d26f6d7", "fields": {"name": "Welcome Email Template", "template_type": "welcome", "subject_template": "Welcome to OxiWorld, {{user.first_name}} - Your Trading Journey Starts Here", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 40px 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { padding: 40px 30px; background: white; }\n    .welcome-badge { background: #E0E7FF; color: #3730A3; padding: 8px 16px; border-radius: 20px; display: inline-block; margin: 20px 0; font-size: 14px; font-weight: 500; }\n    .button { background: #4F46E5; color: white; padding: 14px 28px; text-decoration: none; border-radius: 8px; display: inline-block; margin: 25px 0; font-weight: 600; transition: background 0.3s; }\n    .features { background: #F8FAFC; padding: 20px; border-radius: 8px; margin: 20px 0; }\n    .feature-item { margin: 10px 0; display: flex; align-items: center; }\n    .checkmark { color: #10B981; font-weight: bold; margin-right: 10px; }\n    .footer { background: #F1F5F9; padding: 30px 20px; text-align: center; color: #64748B; font-size: 14px; border-radius: 0 0 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"header\">\n      <h1 style=\"margin: 0; font-size: 28px;\">Welcome to OxiWorld!</h1>\n      <p style=\"margin: 10px 0 0; opacity: 0.9; font-size: 16px;\">Your Forex Trading Journey Begins Now</p>\n    </div>\n    <div class=\"content\">\n      <div class=\"welcome-badge\">Account Created Successfully</div>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Hi {{user.first_name}},</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Welcome to OxiWorld! We're thrilled to have you join our community of successful forex traders.</p>\n      \n      <div class=\"features\">\n        <h3 style=\"margin: 0 0 15px; color: #1F2937;\">What's waiting for you:</h3>\n        <div class=\"feature-item\"><span class=\"checkmark\">•</span> <span>Expert-led forex trading courses</span></div>\n        <div class=\"feature-item\"><span class=\"checkmark\">•</span> <span>Real-time market analysis and insights</span></div>\n        <div class=\"feature-item\"><span class=\"checkmark\">•</span> <span>Interactive trading simulators</span></div>\n        <div class=\"feature-item\"><span class=\"checkmark\">•</span> <span>24/7 community support</span></div>\n      </div>\n\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Ready to start your forex mastery journey?</p>\n      <a href=\"{{custom.dashboard_url}}\" class=\"button\">Access Your Dashboard</a>\n      <p style=\"font-size: 14px; line-height: 1.6; color: #6B7280;\">Need help getting started? Our support team is here to assist you every step of the way.</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Welcome aboard!<br><strong>The OxiWorld Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p style=\"margin: 0;\">© 2025 OxiWorld. All rights reserved.</p>\n      <p style=\"margin: 10px 0 0; font-size: 12px;\">You're receiving this because you created an account with us.</p>\n    </div>\n  </div>\n</body>\n</html>", "text_content": "Hi {{user.first_name}},\n\nWelcome to OxiWorld! \n\nYour account has been successfully created and you're ready to start your forex trading journey.\n\nWhat's waiting for you:\n• Expert-led forex trading courses\n• Real-time market analysis and insights  \n• Interactive trading simulators\n• 24/7 community support\n\nGet started: {{custom.dashboard_url}}\n\nNeed help? Our support team is here to assist you every step of the way.\n\nWelcome aboard!\nThe OxiWorld Team\n\n© 2025 OxiWorld. All rights reserved.", "description": "Sent to new users when they sign up for an account", "available_variables": {"user.email": "User's email address", "company_name": "Company name (OxiWorld)", "current_date": "Current date", "support_email": "Support email address", "user.last_name": "User's last name", "user.first_name": "User's first name"}, "status": "draft", "is_default": true, "is_system_email": false, "from_email": "", "from_name": "OxiWorld Team", "sent_count": 0, "last_used": null, "created_at": "2025-11-14T18:35:22.404Z", "updated_at": "2025-11-14T18:35:22.404Z", "created_by": null}}, {"model": "users.emailtemplate", "pk": "062a1608-6567-4b74-bfba-f4f103c524e3", "fields": {"name": "Telegram Group Access Granted", "template_type": "telegram_added", "subject_template": "Welcome to {{group_name}} Telegram Group", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: #0088CC; color: white; padding: 40px 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { padding: 40px 30px; background: white; }\n    .join-button { background: #0088CC; color: white; padding: 16px 32px; text-decoration: none; border-radius: 8px; display: inline-block; margin: 25px 0; font-weight: 600; font-size: 16px; }\n    .footer { background: #F1F5F9; padding: 30px 20px; text-align: center; color: #64748B; font-size: 14px; border-radius: 0 0 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"header\">\n      <h1 style=\"margin: 0; font-size: 26px;\">Telegram Access Granted</h1>\n    </div>\n    <div class=\"content\">\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Hi {{user.first_name}},</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">You've been granted access to the OxiWorld Telegram group: <strong>{{group_name}}</strong></p>\n      \n      <a href=\"{{join_url}}\" class=\"join-button\" style=\"display: block; text-align: center; text-decoration: none; color: white;\">Join Telegram Group</a>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Welcome to the community!</p>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Best regards,<br><strong>The OxiWorld Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p style=\"margin: 0;\">© 2025 OxiWorld. All rights reserved.</p>\n    </div>\n  </div>\n</body>\n</html>", "text_content": "Hi {{user.first_name}},\n\nTelegram Access Granted\n\nYou've been granted access to: {{group_name}}\n\nJoin now: {{join_url}}\n\nWelcome to the community!\n\nBest regards,\nThe OxiWorld Team\n\n© 2025 OxiWorld. All rights reserved.", "description": "Notification when user is added to Telegram group", "available_variables": {"join_url": "Join URL", "group_name": "Telegram group name", "user.first_name": "User's first name"}, "status": "active", "is_default": true, "is_system_email": true, "from_email": "", "from_name": "", "sent_count": 0, "last_used": null, "created_at": "2025-11-15T15:23:50.863Z", "updated_at": "2025-11-15T15:23:50.863Z", "created_by": null}}, {"model": "users.emailtemplate", "pk": "09e9391f-8881-4d7e-b143-2896d6bf2061", "fields": {"name": "New Sign-in Alert", "template_type": "signin_notification", "subject_template": "New Sign-in to Your OxiWorld Account", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: #1E40AF; color: white; padding: 40px 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { padding: 40px 30px; background: white; }\n    .info-box { background: #F0F9FF; padding: 20px; border-radius: 8px; margin: 20px 0; }\n    .footer { background: #F1F5F9; padding: 30px 20px; text-align: center; color: #64748B; font-size: 14px; border-radius: 0 0 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"header\">\n      <h1 style=\"margin: 0; font-size: 26px;\">New Sign-in Detected</h1>\n    </div>\n    <div class=\"content\">\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Hi {{user.first_name}},</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">We detected a new sign-in to your OxiWorld account.</p>\n      \n      <div class=\"info-box\">\n        <p style=\"margin: 5px 0; color: #374151;\"><strong>Date & Time:</strong> {{signin_datetime}}</p>\n        <p style=\"margin: 5px 0; color: #374151;\"><strong>Device:</strong> {{device}}</p>\n        <p style=\"margin: 5px 0; color: #374151;\"><strong>Location:</strong> {{location}}</p>\n      </div>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">If this was you, no action needed. If not, please secure your account immediately.</p>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Stay secure,<br><strong>The OxiWorld Security Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p style=\"margin: 0;\">© 2025 OxiWorld. All rights reserved.</p>\n    </div>\n  </div>\n</body>\n</html>", "text_content": "Hi {{user.first_name}},\n\nNew Sign-in Detected\n\nDate & Time: {{signin_datetime}}\nDevice: {{device}}\nLocation: {{location}}\n\nIf this was you, no action needed. If not, please secure your account immediately.\n\nStay secure,\nThe OxiWorld Security Team\n\n© 2025 OxiWorld. All rights reserved.", "description": "Security notification for new device sign-in", "available_variables": {"device": "Device information", "location": "Approximate location", "signin_datetime": "Sign-in date and time", "user.first_name": "User's first name"}, "status": "active", "is_default": true, "is_system_email": true, "from_email": "", "from_name": "", "sent_count": 32, "last_used": "2025-11-26T22:50:24.738Z", "created_at": "2025-11-15T15:23:50.815Z", "updated_at": "2025-11-15T15:23:50.815Z", "created_by": null}}, {"model": "users.emailtemplate", "pk": "0f683a31-154a-4e58-8b0f-558ba74eea0e", "fields": {"name": "Password Reset Request", "template_type": "password_reset", "subject_template": "Reset Your OxiWorld Password - Expires in 1 Hour", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: #DC2626; color: white; padding: 40px 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { padding: 40px 30px; background: white; }\n    .reset-button { background: #DC2626; color: white; padding: 16px 32px; text-decoration: none; border-radius: 8px; display: inline-block; margin: 25px 0; font-weight: 600; font-size: 16px; }\n    .footer { background: #F1F5F9; padding: 30px 20px; text-align: center; color: #64748B; font-size: 14px; border-radius: 0 0 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"header\">\n      <h1 style=\"margin: 0; font-size: 26px;\">Password Reset Request</h1>\n      <p style=\"margin: 10px 0 0; opacity: 0.9;\">Secure your account</p>\n    </div>\n    <div class=\"content\">\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Hi {{user.first_name}},</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">We received a request to reset your password. Click the button below to create a new password.</p>\n      \n      <a href=\"{{reset_url}}\" class=\"reset-button\" style=\"display: block; text-align: center; text-decoration: none; color: white;\">Reset Password</a>\n      \n      <p style=\"font-size: 14px; line-height: 1.6; color: #6B7280;\">If the button doesn't work, copy and paste this link:<br>\n      <span style=\"word-break: break-all; color: #DC2626;\">{{reset_url}}</span></p>\n      \n      <p style=\"font-size: 14px; line-height: 1.6; color: #991B1B;\"><strong>This reset link expires in 1 hour for security.</strong></p>\n      \n      <p style=\"font-size: 14px; line-height: 1.6; color: #6B7280;\">If you didn't request this, please ignore this email.</p>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Stay secure,<br><strong>The OxiWorld Security Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p style=\"margin: 0;\">© 2025 OxiWorld. All rights reserved.</p>\n    </div>\n  </div>\n</body>\n</html>", "text_content": "Hi {{user.first_name}},\n\nWe received a request to reset your OxiWorld password.\n\nReset your password: {{reset_url}}\n\nThis link expires in 1 hour for security.\n\nIf you didn't request this, please ignore this email.\n\nStay secure,\nThe OxiWorld Security Team\n\n© 2025 OxiWorld. All rights reserved.", "description": "Sent when user requests password reset", "available_variables": {"reset_url": "Password reset URL", "user.email": "User's email address", "user.first_name": "User's first name"}, "status": "active", "is_default": true, "is_system_email": true, "from_email": "", "from_name": "", "sent_count": 0, "last_used": null, "created_at": "2025-11-15T15:23:50.809Z", "updated_at": "2025-11-15T15:23:50.809Z", "created_by": null}}, {"model": "users.emailtemplate", "pk": "2b1e48af-3fb1-4732-a897-5c99ec053b44", "fields": {"name": "Subscription Expiring Soon", "template_type": "subscription_expiry", "subject_template": "Your {{plan_type}} Subscription Expires Soon", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: #F59E0B; color: white; padding: 40px 20px; text-align: center; border-radius: 8px 8px 0 0; }\n    .content { padding: 40px 30px; background: white; }\n    .countdown { font-size: 32px; font-weight: bold; color: #F59E0B; text-align: center; margin: 20px 0; }\n    .renew-button { background: #F59E0B; color: white; padding: 16px 32px; text-decoration: none; border-radius: 8px; display: inline-block; margin: 25px 0; font-weight: 600; font-size: 16px; }\n    .footer { background: #F1F5F9; padding: 30px 20px; text-align: center; color: #64748B; font-size: 14px; border-radius: 0 0 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"email-container\">\n    <div class=\"header\">\n      <h1 style=\"margin: 0; font-size: 26px;\">Subscription Expiring Soon</h1>\n    </div>\n    <div class=\"content\">\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Hi {{user.first_name}},</p>\n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Your {{plan_type}} subscription will expire soon.</p>\n      \n      <div class=\"countdown\">{{days_remaining}} Days Left</div>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Renew now to continue enjoying premium features.</p>\n      \n      <a href=\"{{renewal_url}}\" class=\"renew-button\" style=\"display: block; text-align: center; text-decoration: none; color: white;\">Renew Subscription</a>\n      \n      <p style=\"font-size: 16px; line-height: 1.6; color: #374151;\">Thank you,<br><strong>The OxiWorld Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p style=\"margin: 0;\">© 2025 OxiWorld. All rights reserved.</p>\n    </div>\n  </div>\n</body>\n</html>", "text_content": "Hi {{user.first_name}},\n\nSubscription Expiring Soon\n\nYour {{plan_type}} subscription will expire in {{days_remaining}} days.\n\nRenew now: {{renewal_url}}\n\nThank you,\nThe OxiWorld Team\n\n© 2025 OxiWorld. All rights reserved.", "description": "Warning about upcoming subscription expiration", "available_variables": {"plan_type": "Subscription plan type", "renewal_url": "Renewal URL", "days_remaining": "Days until expiration", "user.first_name": "User's first name"}, "status": "active", "is_default": true, "is_system_email": true, "from_email": "", "from_name": "", "sent_count": 0, "last_used": null, "created_at": "2025-11-15T15:23:50.850Z", "updated_at": "2025-11-15T15:23:50.850Z", "created_by": null}}, {"model": "users.emailtemplate", "pk": "93b96857-7eb6-4f2b-87fd-4c57d277c9cc", "fields": {"name": "Subscription Activated", "template_type": "subscription_success", "subject_template": "Welcome to {{plan_type}} - Subscription Active", "html_content": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    .email-container { max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; }\n    .header { background: #10B981; color: white; padding: 40px 20px; text-align: c