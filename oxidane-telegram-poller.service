[Unit]
Description=Oxidane Telegram Poller
After=network.target redis.service oxidane-celery.service

[Service]
Type=simple
User=oxidane
Group=oxidane
WorkingDirectory=/var/www/oxidane/backend
Environment="PATH=/var/www/oxidane/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=oxidane.settings"
ExecStart=/var/www/oxidane/venv/bin/python telegram_poller.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
