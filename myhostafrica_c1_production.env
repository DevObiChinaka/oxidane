# MyHostAfrica C1 Production Environment Configuration
# Optimized for 1 vCPU, 2GB RAM, 30GB SSD
# ==================================================

# Database Configuration (PostgreSQL on same VPS)
DATABASE_URL=postgresql://oxidane:secure_db_password_2024@localhost:5432/oxidane_prod

# Redis Configuration (Co-located, memory optimized)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Django Settings
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-production-secret-key-here
ALLOWED_HOSTS=oxiworldforexacademy.com,www.oxiworldforexacademy.com
CORS_ALLOWED_ORIGINS=https://oxiworldforexacademy.com,https://www.oxiworldforexacademy.com
FRONTEND_URL=https://oxiworldforexacademy.com

# C1 Performance Optimizations
# ============================

# Gunicorn Configuration (Memory optimized for 2GB RAM)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_TIMEOUT=30

# Celery Configuration (Resource limited)
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# Database Connection Pool (Conservative for C1)
DATABASE_CONN_MAX_AGE=300
DATABASE_CONN_HEALTH_CHECKS=true

# Cache Configuration (Memory conservative)
CACHE_TTL=1800
CACHE_MAX_ENTRIES=1000

# File Upload Limits (Storage conscious)
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440  # 2.5MB
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440  # 2.5MB
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@oxiworldforexacademy.com

# Payment Configuration
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://oxiworldforexacademy.com/api/telegram/webhook/

# Security Configuration
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Logging Configuration (Space efficient)
LOG_LEVEL=INFO
LOG_MAX_SIZE=50MB
LOG_BACKUP_COUNT=3

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/var/www/oxidane/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/oxidane/media

# Time Zone
TIME_ZONE=UTC
USE_TZ=true

# C1 Resource Monitoring
# ======================
# These are not Django settings but useful for monitoring

# Memory Alert Thresholds
MEMORY_WARNING_THRESHOLD=75  # %
MEMORY_CRITICAL_THRESHOLD=90  # %

# Disk Alert Thresholds  
DISK_WARNING_THRESHOLD=80   # %
DISK_CRITICAL_THRESHOLD=90  # %

# Monitoring Commands (for reference)
# ===================================
# Memory: free -h
# Disk: df -h
# CPU: top or htop  
# Network: nload
# I/O: iotop
# Services: systemctl status oxidane-gunicorn oxidane-celery nginx postgresql redis-server

# C1 Upgrade Recommendations
# ==========================
# If consistently using >80% RAM: Consider upgrading to C2 plan
# If disk usage >90%: Implement log rotation and cleanup scripts
# If CPU usage consistently >80%: Consider C2 or C3 plan upgrade

# Backup Strategy (Important for C1)
# ==================================
# Daily database backups to external storage
# Weekly full system snapshots
# Regular cleanup of old logs and temporary files