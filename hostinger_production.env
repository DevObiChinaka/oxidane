# Hostinger VPS Production Environment Configuration
# Copy this to .env on your Hostinger VPS

# ========================================
# HOSTINGER VPS CONFIGURATION
# ========================================
# Database (PostgreSQL on same VPS)
DATABASE_URL=postgresql://oxidane:YOUR_SECURE_DB_PASSWORD@localhost:5432/oxidane_production

# Redis (on same VPS)
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@localhost:6379/0

# Domain configuration
DOMAIN=oxiworldforexacademy.com
FRONTEND_URL=https://oxiworldforexacademy.com

# Django settings
SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE
DEBUG=False
ALLOWED_HOSTS=oxiworldforexacademy.com,www.oxiworldforexacademy.com

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Use Gmail SMTP or Hostinger email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Alternative: Use Hostinger email
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@oxiworldforexacademy.com
# EMAIL_HOST_PASSWORD=your-hostinger-email-password

# ========================================
# PAYMENT CONFIGURATION
# ========================================
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
PAYSTACK_TEST_MODE=False

# ========================================
# TELEGRAM CONFIGURATION
# ========================================
TELEGRAM_BOT_TOKEN=your:telegram_bot_token_here
TELEGRAM_ADMIN_USER_ID=your_telegram_user_id

# ========================================
# SECURITY SETTINGS
# ========================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ========================================
# CELERY CONFIGURATION
# ========================================
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ========================================
# MONITORING (Optional)
# ========================================
# Sentry for error tracking
# SENTRY_DSN=your_sentry_dsn_here